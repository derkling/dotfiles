#!/bin/bash
# [Config] VSCode synchronization script

set -e

VSCODE_DIR="$HOME/.vscode"
CONFIG_DIR="$HOME/.config/Code/User"
SETTINGS_LIVE="$CONFIG_DIR/settings.json"
SETTINGS_GENERAL="$VSCODE_DIR/settings.general.json"
SETTINGS_WORK="$VSCODE_DIR/settings.work.json"
RECOMMENDED_GENERAL="$VSCODE_DIR/recommended.general"
RECOMMENDED_WORK="$VSCODE_DIR/recommended.work"

# Ensure all required tools are available
check_dependencies() {
    local missing_tools=()
    local required_tools=("code" "jq" "awk" "sed" "grep")
    
    for tool in "${required_tools[@]}"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
    
    if [ ${#missing_tools[@]} -ne 0 ]; then
        echo "Error: The following required tools are missing: ${missing_tools[*]}"
        echo "Please install them before using this script."
        exit 1
    fi
}

check_dependencies

# Helper to clean JSONC (remove comments and trailing commas)
clean_jsonc() {
    awk '
    BEGIN { state = "normal" }
    {
        for (i = 1; i <= length($0); i++) {
            char = substr($0, i, 1)
            next_char = substr($0, i + 1, 1)
            if (state == "normal") {
                if (char == "\"" && (i == 1 || substr($0, i - 1, 1) != "\\")) {
                    state = "string"; printf "%s", char
                } else if (char == "/" && next_char == "/") { break }
                else if (char == "/" && next_char == "*") { state = "comment"; i++ }
                else { printf "%s", char }
            } else if (state == "string") {
                printf "%s", char
                if (char == "\\") { i++; printf "%s", substr($0, i, 1) }
                else if (char == "\"") { state = "normal" }
            } else if (state == "comment") {
                if (char == "*" && next_char == "/") { state = "normal"; i++ }
            }
        }
        if (state != "comment") printf "\n"
    }' "$1" | sed -z 's/,[[:space:]]*\([]}]\)/\1/g'
}

backup_extensions() {
    echo "Backing up VSCode extensions..."
    all_exts=$(code --list-extensions)
    
    # Filter work extensions (google.*)
    echo "$all_exts" | grep "^google\." > "$RECOMMENDED_WORK" || true
    # Filter general extensions (everything else)
    echo "$all_exts" | grep -v "^google\." > "$RECOMMENDED_GENERAL" || true
}

backup_settings() {
    echo "Splitting VSCode settings into general and work..."
    if [ ! -f "$SETTINGS_LIVE" ]; then
        echo "Error: $SETTINGS_LIVE not found"
        return 1
    fi

    # Clean the JSONC
    cleaned=$(clean_jsonc "$SETTINGS_LIVE")
    
    # Split using jq
    echo "$cleaned" | jq 'with_entries(select(.key | startswith("geminicodeassist")))' > "$SETTINGS_WORK"
    echo "$cleaned" | jq 'with_entries(select(.key | startswith("geminicodeassist") | not))' > "$SETTINGS_GENERAL"
}

restore_settings() {
    echo "Merging VSCode settings from general and work..."
    if [ ! -f "$SETTINGS_GENERAL" ]; then
        echo "Error: $SETTINGS_GENERAL not found"
        return 1
    fi

    # Merge with jq
    if [ -f "$SETTINGS_WORK" ]; then
        jq -s '.[0] * .[1]' "$SETTINGS_GENERAL" "$SETTINGS_WORK" > "$SETTINGS_LIVE"
    else
        cp "$SETTINGS_GENERAL" "$SETTINGS_LIVE"
    fi
}

restore_extensions() {
    echo "Restoring VSCode extensions..."
    if [ -f "$RECOMMENDED_GENERAL" ]; then
        echo "Installing general extensions..."
        grep -v "^#" "$RECOMMENDED_GENERAL" | xargs -L 1 code --install-extension
    fi
    if [ -f "$RECOMMENDED_WORK" ]; then
        echo "Installing work extensions..."
        grep -v "^#" "$RECOMMENDED_WORK" | xargs -L 1 code --install-extension
    fi
}

case "$1" in
    backup)
        backup_extensions
        backup_settings
        echo "Backup complete."
        ;;
    restore)
        restore_settings
        restore_extensions
        echo "Restore complete."
        ;;
    *)
        echo "Usage: $0 {backup|restore}"
        exit 1
        ;;
esac
